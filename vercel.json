{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/(.*)", "destination": "/$1", "permanent": true },
    {
      "source": "/horarios/(.*)",
      "destination": "/pt-br/horarios/$1",
      "permanent": true
    }
  ],
  "trailingSlash": true
}
